{
  "ignore": ["spikes/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "eslint/*.js",
        "scripts/e2e/*.e2e.ts",
        "scripts/e2e/playwright.config.ts",
        "scripts/e2e/catalog-dump.ts"
      ]
    },
    "packages/pi-host": {
      "entry": ["src/testing/*.ts", "src/testing/mcp-fixture.mjs", "src/testing/bridge-like-extension.mjs"],
      "ignoreBinaries": [
        "pgrep",
        "pkill",
        "rg",
        "fd",
        "systemd-run",
        "mkfifo",
        "openssl",
        "ssh-keygen",
        "ssh-agent",
        "ssh-add"
      ]
    },
    "apps/web": {
      "entry": ["src/features/appearance/boot-script.js", "vite/*.ts", "sw/sw.ts"]
    },
    "apps/vmd": {
      "ignoreBinaries": ["mkfifo"]
    },
    "apps/daemon": {
      "entry": [
        "src/modules/search/search-thread.ts",
        "src/modules/agent-vm/mirror-parse-thread.ts",
        "src/modules/agent-vm/profile-thread.ts",
        "src/modules/agent-vm/digest-thread.ts"
      ],
      "ignoreBinaries": ["openssl", "loginctl", "systemd-run", "mkfifo"]
    }
  }
}
