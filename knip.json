{
  "ignore": ["spikes/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "eslint/*.js"]
    },
    "packages/pi-host": {
      "entry": ["src/testing/*.ts"],
      "ignoreBinaries": ["pgrep", "pkill", "rg", "fd"]
    },
    "apps/daemon": {
      "ignoreBinaries": ["openssl", "loginctl", "systemd-run"]
    }
  }
}
