{
  "ignore": ["spikes/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "eslint/*.js",
        "scripts/e2e/*.e2e.ts",
        "scripts/e2e/playwright.config.ts",
        "scripts/e2e/catalog-dump.ts"
      ]
    },
    "packages/pi-host": {
      "entry": ["src/testing/*.ts", "src/testing/mcp-fixture.mjs"],
      "ignoreBinaries": ["pgrep", "pkill", "rg", "fd", "systemd-run", "mkfifo"]
    },
    "apps/web": {
      "entry": ["src/features/appearance/boot-script.js", "vite/*.ts", "sw/sw.ts"]
    },
    "apps/daemon": {
      "entry": ["src/modules/search/search-thread.ts"],
      "ignoreBinaries": ["openssl", "loginctl", "systemd-run", "mkfifo"]
    }
  }
}
