#!/bin/sh
# git credential helper of a pap box: answers `get` for github.com (and the test origin) from the token file on /run.
[ "$1" = "get" ] || exit 0
file="${PAP_GUEST_RUN_DIR:-/run}/pap-github/token"
host=""
while IFS= read -r line; do
  case "$line" in host=*) host="${line#host=}" ;; esac
done
allowed="github.com"
if [ -n "${PAP_TEST_GITHUB_ORIGIN:-}" ]; then allowed="$allowed ${PAP_TEST_GITHUB_ORIGIN#*://}"; fi
case " $allowed " in *" $host "*) ;; *) exit 0 ;; esac
[ -r "$file" ] || exit 0
IFS= read -r token < "$file" || true
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
