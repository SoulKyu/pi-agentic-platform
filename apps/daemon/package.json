{
  "name": "@pap/daemon",
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "bin": {
    "pap": "./dist/main.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning ../../scripts/copy-sql.ts",
    "dev": "node --disable-warning=ExperimentalWarning --conditions=development --watch src/main.ts serve --dev"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@hono/node-server": "2.1.3",
    "@pap/contracts": "workspace:*",
    "@pap/pi-host": "workspace:*",
    "@simplewebauthn/server": "13.3.3",
    "hono": "4.13.13",
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
